---
const links = [
  { label: "Proyectos", href: "#proyectos" },
  { label: "Demos", href: "#demos" },
  { label: "Sobre mí", href: "#sobre-mi" },
  { label: "Contacto", href: "#contacto" },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/[0.06] bg-ink/75 backdrop-blur-xl">
  <nav class="section-wrap flex h-[72px] items-center justify-between" aria-label="Navegación principal">
    <a href="#inicio" class="flex items-center gap-2.5 font-semibold tracking-tight" aria-label="Ir al inicio">
      <span>Louis Santeliz<span class="text-lime"></span></span>
    </a>
    <div class="hidden items-center gap-8 text-sm text-muted md:flex">
      {links.map((link) => (
        <a class="transition-colors hover:text-white" href={link.href}>{link.label}</a>
      ))}
    </div>
    <details class="relative md:hidden">
      <summary class="cursor-pointer list-none rounded-full border border-white/10 px-3 py-2 text-xs text-white">Menú</summary>
      <div class="absolute right-0 top-12 flex min-w-40 flex-col gap-1 rounded-2xl border border-white/10 bg-panel p-2 shadow-xl">
        {links.map((link) => (
          <a class="rounded-xl px-3 py-2 text-sm text-muted transition-colors hover:bg-white/[0.06] hover:text-white" href={link.href}>{link.label}</a>
        ))}
      </div>
    </details>
    <a
      href="#contacto"
      class="rounded-full border border-lime/40 px-4 py-2 text-xs font-semibold text-lime transition-colors hover:bg-lime hover:text-ink"
    >
      Hablemos <span aria-hidden="true">↗</span>
    </a>
  </nav>
</header>
