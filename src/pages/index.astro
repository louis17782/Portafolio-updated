---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import HeroVisual from "../components/HeroVisual";
import Projects from "../components/Projects";
import DemoShowcase from "../components/DemoShowcase";
import Testimonials from "../components/Testimonials";
import ContactForm from "../components/ContactForm";
---

<BaseLayout>
  <Navbar />
  <main>
    <section id="inicio" class="relative flex min-h-[760px] items-center overflow-hidden pt-24 sm:min-h-[850px]">
      <div class="grid-glow pointer-events-none absolute inset-x-0 top-0 h-[720px] opacity-50"></div>
      <div class="section-wrap relative grid items-center gap-6 lg:grid-cols-[1.05fr_.95fr]">
        <div class="py-12">
          <div class="mb-7 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-muted">
            <span class="size-2 rounded-full bg-lime shadow-[0_0_12px_#c8ff72]"></span>
            Transformo tus ideas en software funcional, rápido y listo para crecer.
          </div>
          <p class="section-kicker">Desarrollador full-stack · OPTIMIZACIÓN & POSICIONAMIENTO WEB</p>
          <h1 class="mt-5 max-w-3xl text-[clamp(3.4rem,8vw,6.6rem)] font-semibold leading-[.94] tracking-[-.075em]">
            Desarrollo<br />productos digitales <span class="bg-gradient-to-r from-lime to-lilac bg-clip-text text-transparent">que escalan.</span>
          </h1>
          <p class="mt-7 max-w-lg text-base leading-7 text-muted sm:text-lg">
           Transformo tu visión en una plataforma diseñada para atraer clientes, cerrar ventas y escalar tu negocio sin complicaciones.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#proyectos" class="group inline-flex items-center gap-2 rounded-full bg-lime px-5 py-3 text-sm font-semibold text-black transition-transform hover:scale-[1.03]">Explorar proyectos <span class="transition-transform group-hover:translate-x-1">↗</span></a>
            <a href="#contacto" class="rounded-full border border-white/15 px-5 py-3 text-sm font-medium text-white transition-colors hover:border-white/40">Hablemos</a>
          </div>
          <div class="mt-12 flex items-center gap-7 border-t border-white/[0.08] pt-6">
            <div><p class="text-2xl font-semibold">3<span class="text-lime">+</span></p><p class="mt-1 text-xs text-muted">años creando</p></div>
            <div class="h-9 w-px bg-white/10"></div>
            <div><p class="text-2xl font-semibold">24</p><p class="mt-1 text-xs text-muted">proyectos lanzados</p></div>
            <div class="h-9 w-px bg-white/10"></div>
            <div><p class="text-2xl font-semibold">12</p><p class="mt-1 text-xs text-muted">marcas felices</p></div>
          </div>
        </div>
        <div class="relative -my-4">
          <HeroVisual client:visible />
        </div>
      </div>
    </section>

    <section id="proyectos" class="section-wrap py-24 sm:py-32">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div><p class="section-kicker">Trabajo seleccionado · 2022—2026</p><h2 class="section-title">Proyectos que generan<br class="hidden sm:block" /> resultados.</h2></div>
        <p class="max-w-xs text-sm leading-6 text-muted">Cada proyecto empieza con una pregunta y termina con un impacto medible.</p>
      </div>
      <Projects client:visible />
    </section>

    <section id="demos" class="border-y border-white/[0.06] bg-white/[0.015] py-24 sm:py-32">
      <div class="section-wrap">
        <div class="max-w-xl"><p class="section-kicker">Laboratorio interactivo</p><h2 class="section-title">Explora cómo funcionará tu próximo proyecto.<br />Pruébalo aquí.</h2><p class="mt-4 text-sm leading-7 text-muted">Prueba aplicaciones funcionales adaptadas a distintos sectores. Cada demo refleja mi estándar en rendimiento, seguridad y experiencia de usuario.</p></div>
        <DemoShowcase client:load />
      </div>
    </section>

    <section id="sobre-mi" class="section-wrap py-24 sm:py-32">
      <div class="grid gap-10 md:grid-cols-[.8fr_1.2fr] md:items-center">
        <div>
          <p class="section-kicker">Un poco sobre mí</p>
          <h2 class="section-title">Mi filosofía de trabajo: La confianza se construye con consistencia.<br />No con promesas.</h2>
        </div>
        <div class="glass-card rounded-3xl p-7 sm:p-9">
          <p class="text-lg leading-8 text-white/85">Soy Louis, desarrollador full-stack. Mi enfoque no es solo entregar
             tu web funcionando, sino acompañarte en todo el ciclo de vida del proyecto. Asumo cada desarrollo con responsabilidad total, 
             comunicación transparente y soporte continuo para asegurar que tu inversión crezca.</p>
             <br>
             <p class="text-lg leading-8 text-white/85">Mi compromiso contigo es sencillo: 
             transparencia radical, comunicación constante y la certeza de que no dejaré tu proyecto a mitad de camino. Construyo 
             software con visión de negocio, arquitectura sólida y acompañamiento continuo para que tu inversión realmente escale</p>
          <div class="mt-7 flex flex-wrap gap-2">
            {["Astro", "React", "Ruby on Rails", "Node.js", "Workpress", "Shopify"].map((skill) => <span class="rounded-full border border-white/10 px-3 py-1.5 text-xs text-muted">{skill}</span>)}
          </div>
        </div>
      </div>
    </section>

    <section id="reviews" class="border-y border-white/[0.06] bg-white/[0.015] py-24 sm:py-32">
      <div class="section-wrap">
        <p class="section-kicker">Palabras de quienes ya trabajaron conmigo</p>
        <h2 class="section-title">La confianza también<br class="hidden sm:block" /> se construye.</h2>
        <Testimonials client:visible />
      </div>
    </section>

    <section id="contacto" class="section-wrap py-24 sm:py-32">
      <p class="section-kicker">El siguiente paso empieza aquí</p>
      <h2 class="section-title">Hagamos algo<br />extraordinario.</h2>
      <ContactForm client:load />
    </section>
  </main>
  <Footer />
</BaseLayout>
